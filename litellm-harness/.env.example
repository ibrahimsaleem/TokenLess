# TokenLess LiteLLM Gateway — environment variables
# Copy this file to .env and fill in your keys.

# ── Model selection ────────────────────────────────────────────────────────
# Any LiteLLM-supported model string. Examples:
#   claude-haiku-4-5-20251001     (fast, cheap Anthropic)
#   claude-sonnet-4-6             (balanced Anthropic)
#   gpt-4o-mini                   (cheap OpenAI)
#   gpt-4o                        (capable OpenAI)
#   gemini-1.5-flash              (Google)
#   ollama/mistral                (local, FREE — install Ollama first)
#   ollama/llama3                 (local, FREE)
LITELLM_MODEL=claude-haiku-4-5-20251001

# ── API keys (only the one matching your chosen model is required) ─────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=...
COHERE_API_KEY=...
AZURE_API_KEY=...
AZURE_API_BASE=https://your-resource.openai.azure.com/
AZURE_API_VERSION=2024-02-15-preview

# ── Budget (USD) ───────────────────────────────────────────────────────────
# TokenWatch will warn you when you approach these limits.
DAILY_BUDGET_USD=2.00

# ── LiteLLM proxy (optional — run: litellm --config proxy_config.yaml) ────
# If you're running the proxy server, point the app at it instead:
# OPENAI_API_BASE=http://localhost:4000
# OPENAI_API_KEY=sk-tokenless-proxy   # master_key from proxy_config.yaml
